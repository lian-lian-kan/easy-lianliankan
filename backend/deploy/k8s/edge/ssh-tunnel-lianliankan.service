# Root systemd unit on local-server-001 (home K8S worker, 192.168.1.83).
# Carries the game API from the LAN cluster to the public edge:
#   aigchub-001 (8.130.35.126):30012  --ssh-->  192.168.1.83:30800 (NodePort)
# NOTE: the target must be the node IP, not localhost — kube-proxy NodePorts
# do not bind on 127.0.0.1. Sibling of tunnel-to-cloud.service (same key, own
# session, no shared state). Edge routing: aigchub001-ingress.yaml in this dir.
[Unit]
Description=SSH Tunnel for lianliankan API (aigchub-001:30012 -> local:30800)
After=network.target

[Service]
Type=simple
User=root
Restart=always
RestartSec=10s
Environment="AUTOSSH_GATETIME=0"
Environment="AUTOSSH_PORT=0"
ExecStart=/usr/bin/autossh -M 0 -N \
    -o "ServerAliveInterval=30" \
    -o "ServerAliveCountMax=3" \
    -o "StrictHostKeyChecking=no" \
    -o "ExitOnForwardFailure=yes" \
    -o "GatewayPorts=yes" \
    -i /root/.ssh/id_rsa_frp \
    -R 0.0.0.0:30012:192.168.1.83:30800 \
    root@8.130.35.126

[Install]
WantedBy=multi-user.target
